# Copie para .env e preencha os valores.

# ── Autenticação (recomendado em produção/LAN) ─────────────────────
# MESMO valor do SAFENAP_AUTH_TOKEN do backend. Obrigatório quando o
# backend tem auth ativa — sem ele o WS é recusado (1008) e REST dá 401.
VITE_AUTH_TOKEN=

# ── Backend (opcional — default: mesma origem) ──────────────────────
# URL base da API REST (ex: https://backend-host/api)
VITE_API_URL=

# URL do WebSocket (ex: wss://backend-host/ws)
VITE_WS_URL=
