# Copie para .env e preencha os valores.

# ── Autenticação (recomendado em produção/LAN) ─────────────────────
# Token compartilhado backend+frontend. Gere um forte com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Sem esta variável, a autenticação fica DESATIVADA (modo dev).
SAFENAP_AUTH_TOKEN=

# ── CORS (backend) ─────────────────────────────────────────────────
# Origens extras separadas por vírgula (ex: hostname Tailscale, URLs Vercel)
CORS_EXTRA_ORIGINS=
